# Safe, non-secret local configuration.
K12HUB_ENV=local
K12HUB_LOG_LEVEL=INFO
K12HUB_DATA_DIR=data
K12HUB_STRUCTURED_LOGGING=true

# Safe local PostgreSQL defaults. Replace these only in an uncommitted .env file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=k12hub
POSTGRES_USER=k12hub
POSTGRES_PASSWORD=k12hub_local_only

# Required by dbt to tokenize direct student identifiers. Set a private, stable value in the
# environment or an uncommitted .env file. Changing it changes every student surrogate key.
K12HUB_HASH_SALT=replace_with_a_private_stable_value

# Aggregate-only synthetic metric file used by the dbt validation gate.
K12HUB_EXPECTED_METRICS_PATH=data/generated/validate-demo/run-fade190e3f52284e/expected_metrics.json

# Safe local MinIO defaults. Replace these only in an uncommitted .env file.
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=k12hub
MINIO_ROOT_PASSWORD=minio_local_only_change_me
MINIO_SECURE=false
MINIO_RAW_BUCKET=k12-raw
MINIO_STANDARDIZED_BUCKET=k12-standardized
MINIO_QUARANTINE_BUCKET=k12-quarantine
